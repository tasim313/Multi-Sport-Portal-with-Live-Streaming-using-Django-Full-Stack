# ─── Django Core ──────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ─── Database (PostgreSQL) ─────────────────────────────────────────────────────
DB_NAME=sports_portal
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ─── Redis & Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── External Sports Data APIs ────────────────────────────────────────────────
# Free tier at football-data.org — get key at https://www.football-data.org/
FOOTBALL_DATA_API_KEY=

# Free tier at cricapi.com — get key at https://cricapi.com/
CRICKET_API_KEY=

# ─── AI Commentary APIs (at least one required for AI rewriting) ───────────────
# Anthropic Claude API (preferred)
ANTHROPIC_API_KEY=

# OpenAI API (fallback)
OPENAI_API_KEY=

# ─── Production Security ──────────────────────────────────────────────────────
# Uncomment in production (DEBUG=False):
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True

# ─── Wagtail ──────────────────────────────────────────────────────────────────
WAGTAIL_BASE_URL=http://localhost:8000

# ─── Next.js Frontend ─────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ─── Docker / Nginx ───────────────────────────────────────────────────────────
NGINX_PORT=80
NGINX_SSL_PORT=443

# ─── Monitoring (optional) ────────────────────────────────────────────────────
SENTRY_DSN=

# ─── Deployment (EC2) ─────────────────────────────────────────────────────────
# EC2_HOST=your-ec2-ip
# EC2_USER=ubuntu
# EC2_SSH_KEY=<contents of your PEM key>
